# Base URL for the platform API. Leave empty to use the same origin, which is how the Vite dev
# proxy and a production same-origin deployment both work.
VITE_API_BASE_URL=

# VITE_PLATFORM_API_KEY is RETIRED and is no longer read. Do not reintroduce it.
#
# Two reasons, both of which happened. Vite substituted it at build time, so setting it put a
# credential inside the built bundle and therefore inside any image built from it -- pushed to
# a registry, pulled onto machines, kept in layer caches; it happened here, from a .env
# written for a browser check. And it *won* over the runtime credential and could not be
# cleared, so in any environment that set it, signing out silently did nothing and the next
# person to use the tab was still signed in as whoever the key belonged to.
#
# The console signs in with an email and a password now. The session token it receives lives
# in sessionStorage for that tab only and never reaches a build artefact. Ask an administrator
# for an account; there is nothing to configure here.

# Development only: where the Vite proxy forwards backend paths.
VITE_API_PROXY_TARGET=http://localhost:8000
