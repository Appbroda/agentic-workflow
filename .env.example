# Model selection is centralized behind four logical roles. Agents request a role; these
# deployment values decide the model and effort that actually execute it.
#
# Planning, architecture, diagnosis and cross-repository reasoning.
OPENAI_REASONING_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=max
# Maximum wall time for one reasoning-role provider attempt. The SDK's retry budget is separate.
OPENAI_REASONING_TIMEOUT_SECONDS=1800

# Normal feature implementation and every substantive or ambiguous correction.
OPENAI_CODING_MODEL=gpt-5.6-sol
OPENAI_CODING_REASONING_EFFORT=max

# Independent repository and integration review.
OPENAI_REVIEW_MODEL=gpt-5.6-terra
OPENAI_REVIEW_REASONING_EFFORT=high

# Import, lint, formatting and similarly narrow, independently verifiable corrections.
OPENAI_SCOPED_FIX_MODEL=gpt-5.3-codex
OPENAI_SCOPED_FIX_REASONING_EFFORT=high

# The same four roles on the second platform. Which platform executes a feature is chosen by
# the person submitting it and fixed for that feature's life, so both may be configured at
# once and a feature keeps the one it started on across every restart.
#
# Configure a platform completely or not at all. All four models set makes it selectable;
# none set means this deployment simply does not offer it; three of four is a configuration
# mistake and is refused at startup rather than discovered when a feature reaches its
# scoped-fix path.
ANTHROPIC_REASONING_MODEL=claude-opus-5
ANTHROPIC_REASONING_EFFORT=max
ANTHROPIC_CODING_MODEL=claude-opus-5
# `high` rather than `xhigh` or `max`: the coding call is one response whose adaptive
# thinking shares max_tokens with the entire implementation, 128000 is the model's output
# ceiling (there is no larger bound to raise), and AB-Feature-181's medium coding call
# spent the whole bound at `xhigh` without finishing. Reasoning cost also rises far faster
# than output quality, and a twenty to forty-five minute attempt interacts badly with a
# retry budget.
ANTHROPIC_CODING_REASONING_EFFORT=high
ANTHROPIC_REVIEW_MODEL=claude-opus-5
ANTHROPIC_REVIEW_REASONING_EFFORT=high
ANTHROPIC_SCOPED_FIX_MODEL=claude-sonnet-5
ANTHROPIC_SCOPED_FIX_REASONING_EFFORT=high

# How many tokens one Messages API response may produce. Required by that API, unused by the
# Responses API, and per role because the reviewer emits a findings list while the engineer
# emits complete file bodies for a multi-file feature. Too small is not "a shorter answer":
# it is a terminal truncation (`stop_reason: max_tokens`, deterministic, failed once and never
# retried). Thinking spends this same bound before the answer starts, so each bound must hold
# thinking *plus* the answer at that role's configured effort -- startup refuses a bound below
# its effort's floor. The defaults below are applied when these are unset; the old defaults
# (32000/16000/16000) killed every Anthropic run of the AB-Feature-175-180 matrix.
# ANTHROPIC_REASONING_MAX_TOKENS=64000
# ANTHROPIC_CODING_MAX_TOKENS=128000
# ANTHROPIC_REVIEW_MAX_TOKENS=48000
# ANTHROPIC_SCOPED_FIX_MAX_TOKENS=32000

# Effort levels are one of: none, low, medium, high, xhigh, max. Which of them a given model
# accepts differs per model, so declare the exceptions your models have rather than expecting
# this repository to know them. A declared level is omitted from the request, leaving the
# provider's default; anything undeclared is sent and the provider decides.
#
# A tier-suffixed variable below is held to a stricter rule than the unsuffixed ones: naming a
# pairing declared here is refused at startup rather than normalized away, because a preset
# that silently ran at the provider's default would not be the preset that was priced.
# MODEL_REASONING_UNSUPPORTED={"gpt-5.3-codex": ["max"]}
# Models that reject the `temperature` parameter outright, as a JSON array of model
# names. The gpt-5 Responses family is known to the adapter and needs no declaration;
# any newer family that rejects temperature is declared here (AB-Feature-210: gpt-6).
# MODEL_TEMPERATURE_UNSUPPORTED=["gpt-6-astra"]

# How many output tokens each model can produce at most. Declared by the deployment because
# nothing in this repository can know a ceiling, and a table in code would be wrong the day a
# provider raises a limit. This is the one input the custom-model-setup ceiling checks need:
# a setup whose bound exceeds a declared ceiling — or whose effort's floor does — is refused
# at save and at feature start with the honest error (the AB-Feature-181 shape). A model
# absent from the declaration has no known ceiling and those checks do not fire for it.
#
# Only the ceiling this platform has actually observed is shipped: claude-sonnet-5's 128000,
# measured the hard way by AB-Feature-181. Add your other models' ceilings as you confirm
# them — an invented number would refuse valid configurations, which is worse than not firing.
MODEL_MAX_OUTPUT_TOKENS={"claude-sonnet-5": 128000, "claude-fable-5": 128000}

# How many context tokens each model can read. Declared by the deployment for the same
# reason the output ceilings above are: nothing in this repository can know a window, and a
# table in code would be wrong the day a provider raises a limit. This is the one input the
# repository-snapshot budget derivation needs (AB-Feature-212: the snapshot budget was a
# constant while the required set scaled with the model, and every ultra retry was refused
# before the model was called). A model absent from the declaration falls back to the
# default budget, which equals exactly what a 200000-token window derives -- absence is
# never a punishment. Only observed windows are shipped; add your other models' windows as
# you confirm them, because an invented number would misbudget a valid configuration.
MODEL_CONTEXT_WINDOW_TOKENS={"gpt-6-astra": 400000, "claude-fable-5": 200000}

# JSON array of model ids whose reasoning role may read images; a submission with image
# attachments is refused at acceptance unless its reasoning model is declared here. Empty
# (or unset) means none -- fail closed.
# MODEL_VISION_CAPABLE=["gpt-6-astra", "claude-fable-5"]

# ---------------------------------------------------------------------------------------
# Performance tiers
# ---------------------------------------------------------------------------------------
#
# Three cost tiers per platform, selected per feature beside the platform and fixed for that
# feature's life. The naming is the scheme above with a tier segment:
#
#   {PROVIDER}_{TIER}_{ROLE}_MODEL            OPENAI_LOW_CODING_MODEL=gpt-5.3-codex
#   {PROVIDER}_{TIER}_{ROLE}_REASONING_EFFORT ANTHROPIC_MEDIUM_CODING_REASONING_EFFORT=high
#   {PROVIDER}_{TIER}_{ROLE}_MAX_TOKENS       ANTHROPIC_LOW_CODING_MAX_TOKENS=128000
#
# The unsuffixed variables above ARE the `high` tier, so a deployment that sets none of these
# behaves exactly as it always has; a `HIGH_`-suffixed variable, when set, overrides its
# unsuffixed twin. Completeness applies per (platform, tier): all four roles set makes the
# pairing selectable, none set means this deployment does not offer it, and three of four is
# refused at startup by the missing variable's name.
#
# Effort is the dominant lever; model class changes only where a cheaper model is already
# proven in that role. The percentages are estimates, not measurements — and a cheap tier that
# retries more can out-spend an expensive tier that lands sooner.
#
# Per-agent efforts (OPENAI_PLANNER_REASONING_EFFORT and friends) are unchanged and are not
# multiplied by tier: they remain a deployment-wide tuning knob that outranks the resolved
# tier's role-level effort.

# Anthropic — low (Economy), roughly 25-35% of Max.
ANTHROPIC_LOW_REASONING_MODEL=claude-sonnet-5
ANTHROPIC_LOW_REASONING_EFFORT=medium
ANTHROPIC_LOW_CODING_MODEL=claude-sonnet-5
ANTHROPIC_LOW_CODING_REASONING_EFFORT=medium
# 128000 on every tier's coding role: a whole-backend generation truncates at 64000, and a
# truncation costs a full attempt, which no tier saves money on.
ANTHROPIC_LOW_CODING_MAX_TOKENS=128000
ANTHROPIC_LOW_REVIEW_MODEL=claude-sonnet-5
ANTHROPIC_LOW_REVIEW_REASONING_EFFORT=low
# Haiku carries no effort entry: it does not take the effort parameter. Its max_tokens stays
# at the scoped-fix default.
ANTHROPIC_LOW_SCOPED_FIX_MODEL=claude-haiku-4-5

# Anthropic — medium (Standard), roughly 45-60% of Max. The expected everyday tier: Sonnet 5
# sits near Opus on coding at high effort, which is what makes cutting effort before model
# class the right trade.
ANTHROPIC_MEDIUM_REASONING_MODEL=claude-opus-5
ANTHROPIC_MEDIUM_REASONING_EFFORT=high
ANTHROPIC_MEDIUM_CODING_MODEL=claude-sonnet-5
# `high`, not `xhigh`: AB-Feature-181 spent the entire 128000-token bound -- the model's
# output ceiling -- on `xhigh` thinking plus a partial implementation and truncated.
ANTHROPIC_MEDIUM_CODING_REASONING_EFFORT=high
ANTHROPIC_MEDIUM_CODING_MAX_TOKENS=128000
ANTHROPIC_MEDIUM_REVIEW_MODEL=claude-sonnet-5
ANTHROPIC_MEDIUM_REVIEW_REASONING_EFFORT=high
ANTHROPIC_MEDIUM_SCOPED_FIX_MODEL=claude-sonnet-5
ANTHROPIC_MEDIUM_SCOPED_FIX_REASONING_EFFORT=high

# Anthropic — high (Max) is the unsuffixed configuration above. Set the coding bound to
# 128000 there too, for the reason the tiers do.
# ANTHROPIC_CODING_MAX_TOKENS=128000

# Anthropic — ultra (Ultra), above Max: Fable on the judgment-heavy roles. Reasoning at
# `max` (the 64000 platform bound is exactly the `max` floor). Coding at `high`, not
# `xhigh`/`max`: with the bound flush at Fable's declared 128000 ceiling, a higher effort is
# the exact shape that exhausted AB-Feature-181 — thinking and the answer share the bound.
# Review at `xhigh` with its own 64000 bound (the 48000 platform bound is the `xhigh` floor
# with zero headroom — AB-Feature-180's reviewer died on a tight bound). Scoped fixes stay
# on Sonnet at `high`: a localized mechanical repair does not need Fable's price.
# Requires the fable ceiling declared in MODEL_MAX_OUTPUT_TOKENS below, and note
# claude-fable-5 requires 30-day data retention at the organization level.
ANTHROPIC_ULTRA_REASONING_MODEL=claude-fable-5
ANTHROPIC_ULTRA_REASONING_EFFORT=max
ANTHROPIC_ULTRA_CODING_MODEL=claude-fable-5
ANTHROPIC_ULTRA_CODING_REASONING_EFFORT=high
ANTHROPIC_ULTRA_REVIEW_MODEL=claude-fable-5
ANTHROPIC_ULTRA_REVIEW_REASONING_EFFORT=xhigh
ANTHROPIC_ULTRA_REVIEW_MAX_TOKENS=64000
ANTHROPIC_ULTRA_SCOPED_FIX_MODEL=claude-sonnet-5
ANTHROPIC_ULTRA_SCOPED_FIX_REASONING_EFFORT=high

# OpenAI — low (Economy), roughly 20-30% of Max. Codex is promoted to coder here because it is
# already trusted for localized mechanical corrections, which is exactly the envelope the
# Economy label promises.
OPENAI_LOW_REASONING_MODEL=gpt-5.6-terra
OPENAI_LOW_REASONING_EFFORT=medium
OPENAI_LOW_CODING_MODEL=gpt-5.3-codex
OPENAI_LOW_CODING_REASONING_EFFORT=high
OPENAI_LOW_REVIEW_MODEL=gpt-5.6-terra
OPENAI_LOW_REVIEW_REASONING_EFFORT=medium
OPENAI_LOW_SCOPED_FIX_MODEL=gpt-5.3-codex
OPENAI_LOW_SCOPED_FIX_REASONING_EFFORT=medium

# OpenAI — medium (Standard), roughly 50-65% of Max. Sol stays the coder and the effort drops:
# this stack has no proven mid-tier coder, since terra has only ever reviewed. Review stays
# terra at `high` in both medium and high — a bad approval costs more than the review saved.
OPENAI_MEDIUM_REASONING_MODEL=gpt-5.6-sol
OPENAI_MEDIUM_REASONING_EFFORT=high
OPENAI_MEDIUM_CODING_MODEL=gpt-5.6-sol
OPENAI_MEDIUM_CODING_REASONING_EFFORT=high
OPENAI_MEDIUM_REVIEW_MODEL=gpt-5.6-terra
OPENAI_MEDIUM_REVIEW_REASONING_EFFORT=high
OPENAI_MEDIUM_SCOPED_FIX_MODEL=gpt-5.3-codex
OPENAI_MEDIUM_SCOPED_FIX_REASONING_EFFORT=high

# OpenAI — high (Max) is the unsuffixed configuration above: sol at `max` for reasoning and
# coding, terra at `high` for review, codex at `high` for scoped fixes.

# OpenAI — ultra (Ultra), above Max: astra everywhere. Reasoning and coding at `max`, review
# at `xhigh`, scoped fixes at `high`. No output bounds — the Responses API keeps the
# provider's default, like every OpenAI tier.
OPENAI_ULTRA_REASONING_MODEL=gpt-6-astra
OPENAI_ULTRA_REASONING_EFFORT=max
OPENAI_ULTRA_CODING_MODEL=gpt-6-astra
OPENAI_ULTRA_CODING_REASONING_EFFORT=max
OPENAI_ULTRA_REVIEW_MODEL=gpt-6-astra
OPENAI_ULTRA_REVIEW_REASONING_EFFORT=xhigh
OPENAI_ULTRA_SCOPED_FIX_MODEL=gpt-6-astra
OPENAI_ULTRA_SCOPED_FIX_REASONING_EFFORT=high

# Below this, a classification model's answer is not trusted. Uncertainty stays on CODING; it
# never selects SCOPED_FIX to save cost.
MODEL_ROUTER_MIN_CONFIDENCE=0.80
# End users provide these only as X-OpenAI-Api-Key and X-Anthropic-Api-Key when starting or
# resuming a workflow, or store them per identity. Leave them unset in the API container so
# provider credentials remain request-scoped.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required only when the stored Anthropic credential is an identity-linked key ("acts as
# you"): those keys are not bound to one workspace, and the Messages API rejects their
# requests with a 400 unless every request names the workspace it acts in. Find the
# wrkspc_... id in the Anthropic Console. Workspace-scoped keys leave this unset.
ANTHROPIC_WORKSPACE_ID=

# The deployment's shared administrative credential. Optional, and leaving it unset is the
# target state: every person has an account with a password, and anybody holding this key is
# an unnamed administrator with every permission. Keep it only as break-glass access for the
# case where a per-user token cannot be resolved because the database is what is broken -- and
# prefer an admin token issued in advance, which can be revoked and does not live in a file.
# An empty value means unset, not a key nobody can guess.
PLATFORM_API_KEY=

# The administrator's first password, set once at startup and never overwritten. Set it for
# the first boot of a new deployment, then REMOVE IT from the environment: the account is
# created with must_change_password, so the value stops being usable as soon as the
# administrator picks their own. Never commit a value here.
BOOTSTRAP_ADMIN_EMAIL=akhilesh@appbroda.com
BOOTSTRAP_ADMIN_PASSWORD=

# How long a console login lasts, and how fast somebody may guess a password. The login limit
# is counted in Redis per source address and per email; a counter that cannot be reached
# allows the attempt rather than locking the deployment out.
SESSION_TOKEN_TTL_HOURS=12
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Host-machine development connection strings for docker-compose.yml services.
DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/ai_platform
REDIS_URL=redis://localhost:6379/0
# Direct host runs should use an absolute, user-writable directory. Docker Compose maps its
# separate CONTAINER_WORKSPACE_ROOT value to the managed workspace volume.
WORKSPACE_ROOT=/tmp/ai-platform-workspaces
CONTAINER_WORKSPACE_ROOT=/workspaces

LOG_LEVEL=INFO
# JSON list. Replace these local values with the exact API hostnames before production deployment.
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Immutable runtime identity. Before every image build, export BUILD_REVISION from the exact
# checkout (`git rev-parse HEAD`). Production intentionally refuses this placeholder. Compose
# supplies it both as image metadata and as the deployment controller's expected revision.
BUILD_REVISION=unknown
# Must match workflow_schema.WORKFLOW_SCHEMA_VERSION for this deployment.
WORKFLOW_SCHEMA_VERSION=1.0

# Seals provider credentials at rest so a feature can be resumed without somebody present
# to retype an API key. Optional: leave it unset and the platform keeps its original
# behaviour of never persisting a provider secret, with the credential endpoints answering
# "this deployment does not store credentials".
#
# Generate one with:
#   python -c "from services.secrets import generate_encryption_key; print(generate_encryption_key())"
#
# It belongs in the environment and never in the database it protects. Losing it does not
# lose any workflow data -- stored credentials simply have to be entered again.
# SECRET_ENCRYPTION_KEY=v1:<base64 32 bytes>
# During rotation, make the new version current and retain old versioned keys as JSON until
# stored rows have been re-sealed on use. Never reuse a version label for different material.
# SECRET_ENCRYPTION_PREVIOUS_KEYS=["v1:<old base64 32 bytes>"]

# Local PostgreSQL container settings. Change POSTGRES_PASSWORD outside local development.
POSTGRES_DB=ai_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_PORT=5432
REDIS_PORT=6379
